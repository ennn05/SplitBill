PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/splitbill

# Guest session JWTs are signed with this secret; rotate to invalidate all guest sessions at once
GUEST_JWT_SECRET=change-me-to-a-long-random-string

# Firebase Admin (payer auth) - path to a service account JSON, or the individual fields below
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LLM used for receipt extraction (Gemini has a free tier - see README). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Public URL the join link/QR should point to (the deployed web app)
WEB_APP_URL=http://localhost:3000
